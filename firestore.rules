rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isValidShape(data) {
      return data.type is string &&
             data.createdAt is number;
    }
    
    function isValidCursor(data) {
      return data.id is string &&
             data.x is number &&
             data.y is number &&
             data.lastActive is number;
    }

    match /rooms/{roomId} {
      // Allow access to the room document itself if needed
      allow read, write: if true; 

      match /shapes/{shapeId} {
        allow read: if true;
        allow create, update: if isValidShape(request.resource.data);
        allow delete: if true;
      }

      match /cursors/{cursorId} {
        allow read: if true;
        allow write: if isValidCursor(request.resource.data);
      }
    }
  }
}
